function addMonth(s, n) { const d = pd(s); return ymd(new Date(d.getFullYear(), d.getMonth() + n, 1)); }
function monthV(first) {
  const d0 = pd(first), y = d0.getFullYear(), m = d0.getMonth(), t = today(), D = S.draft;
  const startW = d0.getDay(), days = new Date(y, m + 1, 0).getDate();
  let cells = '';
  for (let i = 0; i < startW; i++) cells += '<span></span>';
  for (let k = 1; k <= days; k++) {
    const s = ymd(new Date(y, m, k)), wd = (startW + k - 1) % 7;
    const past = s < t, isS = s === D.start, isE = s === D.end, inR = D.start && D.end && s > D.start && s < D.end;
    const cls = ['dc', past && 'past', isS && 's', isE && 'e', inR && 'in', D.start && D.end && D.start !== D.end && isS && 'rs', D.start && D.end && D.start !== D.end && isE && 're', s === t && 'today', wd === 0 && 'sun', wd === 6 && 'sat'].filter(Boolean).join(' ');
    cells += `<button class="${cls}" ${past ? 'disabled' : ''} data-act="pickDate" data-d="${s}" aria-label="${md(s)}"${isS || isE ? ' aria-pressed="true"' : ''}><span>${k}</span></button>`;
  }
