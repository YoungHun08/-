// ---- 교통비: 숫자 먼저, 자세한 건 ‘가격 상세보기’ ----
function fareLines(p, di) {
  const c = computeDay(p, di), out = [];
  c.rows.forEach((r, i) => out.push({ a: ptName(p, di, i), b: itemName(p, r.it), leg: r.leg }));
  out.push({ a: ptName(p, di, c.rows.length), b: c.day.end.kind === 'airport' ? '공항' : '숙소', leg: c.endLeg });
  return out.filter(x => x.leg.mode !== 'none');
}
function fareDetail(p, di, fd) {
  const modes = p.set.passes || [], pd = fareHead(p, farePlan(p)).t.days[di], dz = fd.zones.includes('dazaifu'), cov = pd.m ? passCovKinds(pd.m, dz) : [], P = pd.m ? PASS[pd.m] : null, mode = pd.m ? 'pass' : 'none';
  const lines = fareLines(p, di).map(x => ({ ...x, unc: (x.leg.fare || []).filter(f => !cov.includes(f.k)) })).filter(x => x.unc.length);
  const by = Object.entries(fd.by).filter(([k, v]) => v > 0 && !cov.includes(k));
  const tx = taxiAll(p, di);
  const sv = Math.max(0, ...['city', 'subway'].map(m => { const x = passDaySingle(fd, m); return x.use ? fd.raw - x.cost : 0; }));
  const note = !modes.length
    ? (sv > 0 ? `<p class="fd-how">${ic('spark')}패스를 사면 이 날 ${yen(sv)} 절약할 수 있어요 <small>(패스를 구매한 사람만 해당)</small></p>` : '')
    : P ? `<p class="fd-how">${ic('ticket')}<span><b>${passLabel(p, pd.m)}을 구매한 사람 기준</b>이에요. 패스로 타는 구간(${P.covers})은 뺐어요. 패스 ${yen(pd.price)}은 따로 들어요.</span></p>` : '';
  return `<div class="fdet">
    ${lines.length ? `<ul class="fl">${lines.map(x => `<li>${modeIc(x.leg.mode, 'xs')}<span class="fl-t"><b>${esc(x.a)} → ${esc(x.b)}</b><small>${MODE[x.leg.mode].n} ${x.leg.min}분${depTxt(x.leg) ? ` · ${depTxt(x.leg)} 출발` : ''}</small></span><em>${fareTxt(x.unc, true)}</em></li>`).join('')}</ul>`
      : `<p class="note">${ic(mode === 'none' ? 'walk' : 'ticket')}<span>${mode === 'none' ? '걸어서 다녀서 교통비가 들지 않아요.' : '패스 밖에서 드는 교통비가 없어요.'}</span></p>`}
    ${by.length ? `<div class="chips">${by.map(([k, v]) => `<span class="chip">${FARE_KIND[k]} ${yen(v)}</span>`).join('')}${fd.boat ? `<span class="chip">뱃놀이 ${yen(fd.boat)} 별도</span>` : ''}</div>` : ''}
    ${note}
    ${tx > 0 ? `<p class="fd-tx">${ic('taxi')}택시로만 다니면 약 ${yen(tx)}</p>` : ''}
    <p class="fine">어른 1명 기준 · 버스·택시는 거리로 계산한 추정치예요.</p>
  </div>`;
}
function taxiAll(p, di) {
  const c = computeDay(p, di); let t = 0;
  [...c.rows.map(r => r.leg), c.endLeg].forEach(l => {
    const w = l.opts.find(o => o.mode === 'walk'), tx = l.opts.find(o => o.mode === 'taxi' || o.mode === 'car');
    if (w && w.min <= 10) return;
    if (tx) t += fareSum(tx.fare); else t += fareSum(l.fare);
  });
  return t;
}

function schedTab() {
  const p = S.plan, N = p.days.length, c = computeDay(p, S.di), day = c.day, fp = farePlan(p), fd = fp.days[S.di];
  const slack = c.deadline - c.endArr, last = S.di === N - 1, vbox = visitedBox(p, S.di), fh = fareHead(p, fp), hasPass = fh.modes.length > 0, dayNum = hasPass ? fh.t.days[S.di].outside : fd.raw;
  const picks = day.items.filter(i => !i.fixed).length, asg = assignedMap(p), left = p.wish.filter(id => asg[id] == null && p.visited[id] == null).length;
  const isToday = day.date === today(), open = !!S.fareOpen['s' + S.di];
  const hasLive = day.items.some(i => i.arrAct != null || i.leave != null);
  const areas = dayAreaNames(p, S.di).join(' · ');
  const head = `<section class="daycard">
      <div class="dc-h"><div><h2>${S.di + 1}일차</h2><small>${md(day.date)}${areas ? ' · ' + areas : ''}</small></div>
      <button class="ib sm" data-act="dayTime" aria-label="출발·마무리 시간 맞추기">${ic('clock')}</button></div>
      ${picks ? `<div class="stats s3"><div><small>출발</small><b>${fmt(c.start)}</b></div><div><small>마무리</small><b class="${c.over > 0 ? 'bad-t' : ''}">${fmt(c.endArr)}</b></div><div><small>걷기</small><b>${c.walkKm.toFixed(1)}km</b></div></div>
      <div class="farerow"><div class="fr-n"><small>${hasPass ? '패스 외 교통비' : '교통비'}</small><b>${fd.approx ? '약 ' : ''}${yen(dayNum)}</b>${hasPass ? `<span>${fh.label} 구매한 사람 기준</span>` : ''}</div><button class="lnk" data-act="fareToggle" data-k="s${S.di}" aria-expanded="${open}">가격 상세보기 ${ic(open ? 'up' : 'down', 'chev')}</button></div>
      ${open ? fareDetail(p, S.di, fd) : ''}
      ${passBox(p, S.di, fp)}` : ''}
      ${flightMemo(p, S.di)}
    </section>`;
  const liveBar = isToday ? `<div class="livebar">${ic('clock')}<span><b>지금 ${nowHM()}</b><small>늦어졌다면 지금 시각으로 맞춰 보세요. 이후 지하철·열차가 ‘가장 빠른 다음 차’로 다시 계산돼요. 장소마다 ‘지금 출발’ 버튼이 있어요.</small></span><button class="btn live sm" data-act="startNow">지금 출발</button></div>` : '';
  if (!picks) {
    return `${head}${liveBar}${bannerV()}
      <div class="card empty-day">
        <div class="ed-ic">${ic('heart')}</div>
        <h3>오늘 갈 곳을 골라 볼까요?</h3>
        <p>${p.wish.length ? `체크해 둔 ${p.wish.length}곳 중에서 이 날 갈 곳만 몇 개 고르면, 가장 덜 돌아가는 순서와 이동 방법·교통비를 바로 계산해 드려요. 전날 밤에 미리 골라 둬도 좋아요.` : '아직 체크한 곳이 없어요. 위시 탭에서 가고 싶은 곳을 먼저 체크해 보세요.'}</p>
        <div class="row2">${p.wish.length ? `<button class="btn pri" data-act="pickOpen">${ic('plus')}갈 곳 고르기${left ? ` · ${left}곳 남음` : ''}</button>` : `<button class="btn pri" data-act="tab" data-t="wish">${ic('heart')}가고 싶은 곳 체크하기</button>`}</div>
      </div>
      ${vbox}
      <p class="fine">이동 시간·요금·영업시간은 대략적인 값이에요. 방문 전에 확인하세요.</p>`;
  }
  let tl = `<ol class="tl">`;
  tl += `<li class="anc"><div class="tm"><b>${fmt(c.start)}</b></div><div class="anc-w"><button class="anc-c" data-act="dayTime">${ic(day.start.kind === 'airport' ? 'plane' : 'home')}<span>${anchorLabel(day.start, false)}</span>${ic('clock', 'chev')}</button><button class="nowbtn" data-act="startNow">${ic('clock')}지금 출발</button></div></li>`;
  c.rows.forEach((r, i) => { tl += legRow(r.leg, i) + itemRow(p, r, i, N); });
  tl += legRow(c.endLeg, c.rows.length);
  tl += `<li class="anc"><div class="tm"><b>${fmt(c.endArr)}</b></div><div class="anc-c end">${ic(day.end.kind === 'airport' ? 'plane' : 'home')}<span>${anchorLabel(day.end, true)}</span></div></li></ol>`;
  const status = c.over > 0
    ? `<div class="note bad">${ic('alert')}<span>${last ? '공항 도착 기준' : '마무리 시간'}(${day.end.time})보다 <b>${c.over}분</b> 늦어요. 한 곳을 빼거나 머무는 시간을 줄여 보세요.</span><button class="btn soft sm" data-act="pickOpen">갈 곳 바꾸기</button></div>`
    : slack >= 60 ? `<div class="note ok">${ic('clock')}<span>${day.end.time}까지 <b>${dur(slack)}</b> 여유${left ? ` · 위시 ${left}곳 남음` : ''}</span><button class="btn soft sm" data-act="pickOpen">더 고르기</button></div>` : '';
  return `${head}${liveBar}
    ${S.hintOff ? '' : `<div class="hint">${ic('walk')}<span>이동 칸을 누르면 <b>지하철·버스·택시</b>를 비교해 바꿀 수 있어요. 걷기로 바꾸면 길 위 맛집·명소도 추천해요.</span><button class="ib xs" data-act="hideHint" aria-label="안내 닫기">${ic('close')}</button></div>`}
    ${bannerV()}
    ${tl}
    ${status}
    <div class="row2 day-act"><button class="btn soft" data-act="pickOpen">${ic('heart')}갈 곳 바꾸기</button><button class="btn soft" data-act="replanDay">${ic('route')}최적 루트 다시</button></div>
    ${vbox}
    ${hasLive ? `<button class="lnk center" data-act="clearLive">${ic('sync')}실시간 보정 모두 해제</button>` : ''}
    <p class="fine">이동 시간·요금·영업시간은 대략적인 값이에요. 지하철·열차 출발 시각은 실제 시간표가 아니라 배차 간격 기준 추정이에요. 방문 전에 확인하세요.</p>`;
}

// ---- 위시 탭 ----
function wishTab() {
  const p = S.plan, asg = assignedMap(p), vN = Object.keys(p.visited).length, n = p.wish.length - vN, left = p.wish.filter(id => asg[id] == null && p.visited[id] == null).length;
