    ${wishControls()}
    <div id="wishList">${wishListHTML()}</div>`;
}

// ---- 교통비 탭 ----
function fareTab() {
  const p = S.plan, fp = farePlan(p), fh = fareHead(p, fp), modes = fh.modes, hasPass = modes.length > 0;
  const picks = p.days.reduce((t, d) => t + d.items.filter(i => !i.fixed).length, 0);
  const recs = [];
  const capDays = fp.days.filter(d => d.useSubCap).length, busDays = fp.days.filter(d => d.useBusPass).length, cityDays = fp.days.filter(d => d.useCity).length;
  if (fp.days.some(d => d.sub > 0)) recs.push({ ok: true, t: '지하철은 신용카드 터치로 타기', d: `Visa·Mastercard·JCB 등 컨택리스 카드를 개찰구에 대면 하루 ${yen(FARE.subwayCap)}까지만 나가요. 1일권(${yen(FARE.subwayCap)})을 사도 같아요.${capDays ? ` ${capDays}일은 상한에 걸려 이득이에요.` : ''}` });
  if (cityDays) recs.push({ ok: true, t: `${cityDays}일은 투어리스트 시티패스가 이득`, d: '지하철·버스·니시테츠 전철·시영 도선을 하루 동안 무제한. 외국인 여행자 전용(여권 필요).' });
  if (busDays) recs.push({ ok: true, t: `${busDays}일은 니시테츠 버스 1일권이 이득`, d: `시내버스 하루 무제한 약 ${yen(FARE.busDay)}.` });
  fp.multi.filter(m => m.good || m.value >= m.price * 0.3).forEach(m => recs.push({ ok: m.good, t: m.good ? `${m.name} 사기` : `${m.name}은 손해`, d: `${m.good ? '' : '이번 일정에선 '}${m.good ? `${m.from + 1}일차부터 쓰면 ${yen(m.save)} 아껴요` : `${yen(-m.save)} 더 들어요`}. ${m.note}` }));
  if (picks && !fp.days.some(d => d.raw > 0)) recs.push({ ok: true, t: '대부분 걸어서 다녀요', d: '이번 일정은 교통비가 거의 들지 않아요.' });
  const seg = [['none', '패스 없이', !hasPass], ['subway', passNm('subway', fh.n), modes.includes('subway')], ['city', passNm('city', fh.n), modes.includes('city')]], N = p.days.length;
  const heroLine = !picks ? '날마다 갈 곳을 고르면 교통비가 계산돼요'
    : !hasPass ? (fh.bestSave ? `패스(${fh.bestSave.label})를 사면 <b>${yen(fh.bestSave.save)} 절약</b>할 수 있어요 <small>(패스를 구매한 사람만 해당)</small>` : '이 일정에선 패스를 사지 않아도 돼요')
    : `${fh.label} 구입비 ${yen(fh.t.passCost)}은 별도예요 · <b>${fh.label}을 구매한 사람 기준</b>${fh.t.save < 0 ? `<br><small>패스 없이 다니는 것보다 ${yen(-fh.t.save)} 더 들어요</small>` : ''}`;
  return `<section class="fare-hero">
      <small>${!hasPass ? '이번 여행 교통비 · 1인' : '패스 외 교통비 · 1인'}</small>
      <div class="fh-n"><b>${picks ? (fp.approx ? '약 ' : '') + yen(fh.num) : '–'}</b></div>
      <p>${heroLine}</p>
    </section>
    <div class="seg pseg" role="group" aria-label="패스 선택 (중복 선택 가능)">${seg.map(([k, l, on]) => `<button class="${on ? 'on' : ''}" data-act="setPass" data-v="${k}" aria-pressed="${on}">${l}</button>`).join('')}</div>
    ${hasPass ? passStepper(fh.n, N) : ''}
    <h2 class="sec">날짜별</h2>
    <div class="fday">${fp.days.map((d, i) => {
      const day = p.days[i], n = day.items.filter(x => !x.fixed).length, open = !!S.fareOpen['t' + i], num = hasPass ? fh.t.days[i].outside : d.raw;
      return `<div class="fd"><div class="fd-h"><b>${i + 1}일차</b><small>${mds(d.date)}</small>${n ? `<span class="fd-n">${d.approx ? '약 ' : ''}${yen(num)}</span>` : (d.raw > 0 ? `<span class="fd-n">${yen(num)}</span>` : '<span class="fd-n none">–</span>')}</div>
        ${n ? `<p class="fd-s">${n}곳 · ${dayAreaNames(p, i).join(' · ')}${hasPass && fh.t.days[i].use ? ' · 패스 쓰는 날' : ''}</p><button class="lnk" data-act="fareToggle" data-k="t${i}" aria-expanded="${open}">가격 상세보기 ${ic(open ? 'up' : 'down', 'chev')}</button>${open ? fareDetail(p, i, d) : ''}`
          : `<p class="fd-s">아직 고른 곳이 없어요${d.raw > 0 ? ' · 공항 이동만 계산했어요' : ''}</p><button class="lnk" data-act="fareDay" data-i="${i}">갈 곳 고르러 가기</button>`}
      </div>`;
    }).join('')}</div>
    <details class="card tips"><summary>${ic('spark')}<b>절약 팁 · 패스 추천 · 요금 기준</b>${ic('down', 'chev')}</summary>
      ${recs.length ? `<ul class="recs-l">${recs.map(r => `<li class="${r.ok ? 'ok' : 'no'}"><span class="rk">${ic(r.ok ? 'check' : 'close')}</span><span class="rb"><b>${esc(r.t)}</b><small>${esc(r.d)}</small></span></li>`).join('')}</ul>` : ''}
      <div class="fare-info"><dl>
        <dt>지하철</dt><dd>거리별 ${yen(210)}~${yen(380)} · 1일권 ${yen(FARE.subwayCap)} (신용카드 터치도 하루 ${yen(FARE.subwayCap)} 상한)</dd>
        <dt>시내버스</dt><dd>도심 구간 ${yen(150)}, 그 밖은 거리에 따라 · 공항 국제선 ↔ 하카타역 약 ${yen(FARE.airportBus)}</dd>
        <dt>택시</dt><dd>1.1km까지 ${yen(600)}, 이후 287m마다 ${yen(100)} (2026년 7월 개정) · 도로 거리를 직선의 1.3배로 추정</dd>
        <dt>시티패스</dt><dd>${yen(FARE.cityPass)} · 다자이후 포함 ${yen(FARE.cityPassDz)} · 다자이후 직행버스 타비토는 제외</dd>
      </dl><p class="fine">어른 1명 기준이에요. 버스·택시와 일부 JR은 거리로 계산한 추정치라 실제와 다를 수 있어요.</p></div>
    </details>`;
}
function bottomNav() {
  const T = [['sched', 'list', '일정'], ['map', 'map', '지도'], ['wish', 'heart', '위시'], ['fare', 'wallet', '교통비']];
