<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#E6F0F7">
<title>후쿠오카 여행 플래너</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Gothic+A1:wght@400;500;600;700;800&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet">
<style>
/* 후쿠오카 여행 플래너 · 모바일 앱 스타일
   배경은 안개 낀 하늘빛, 카드는 살짝 푸른 기가 도는 화이트, 포인트는 바다 파랑과 노을 코랄.
   지도는 구글맵처럼 연한 베이지 땅 + 하늘색 바다 + 연두 공원, 핀은 빨강, 경로는 파랑. */
:root {
  --outer: #D5E3EE; --bg: #E6F0F7; --surface: #F9FCFE; --surface-2: #EAF2F8; --surface-3: #D9E7F1;
  --ink: #0F2438; --ink-2: #4B6076; --ink-3: #8499AD; --line: #D2E1EC;
  --pri: #1F7AE0; --pri-2: #DCEBFB; --pri-ink: #FFFFFF; --pink: #FF6B6B;
  --accent: #FF7048; --accent-2: #FFE8DF;
  --blue: #1F7AE0; --blue-2: #DCEBFB;
  --ok: #138A55; --ok-2: #DDF3E8; --warn: #A86400; --warn-2: #FFF1D4; --bad: #D8343A; --bad-2: #FDE8E8;
  --pin: #E8453C; --pin-2: #B3261E; --route: #3B82F6;
  --sea: #A9D4F2; --sea-edge: #86BCE3; --land: #F1EEE6; --park: #CBE6C4; --hill-a: #E2E6D1; --hill-b: rgba(226, 230, 209, 0); --river: #A9D4F2; --rail: #A7B0BA;
  --art-sky1: #FFD3B8; --art-sky2: #FFB39C; --art-sun: #FFF4E6; --art-city: rgba(255, 255, 255, .55); --art-sea: rgba(255, 255, 255, .22);
  --font: 'Gothic A1', -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
  --num: 'Outfit', 'Gothic A1', sans-serif;
  --r: 20px; --sh: 0 1px 2px rgba(15, 36, 56, .05), 0 6px 18px rgba(31, 90, 150, .09);
  --grad: linear-gradient(135deg, #3BA6F2 0%, #1F7AE0 55%, #3F5BD8 100%);
  --hero: linear-gradient(160deg, #FFB48A 0%, #FF7F7A 36%, #6D8DF0 100%);
  --glass: color-mix(in srgb, var(--bg) 82%, transparent);
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --outer: #050B12; --bg: #0C1621; --surface: #142232; --surface-2: #1B2C3E; --surface-3: #243950;
    --ink: #EAF1F8; --ink-2: #A5B6C8; --ink-3: #6C8197; --line: #243950;
    --pri: #5AA2F5; --pri-2: #17304D; --pink: #FF7F8C; --accent: #FF8A64; --accent-2: #3A2218; --blue: #7DB4FF; --blue-2: #17304D;
    --ok: #4CCB8B; --ok-2: #123324; --warn: #F0B55A; --warn-2: #33280F; --bad: #FF7A7E; --bad-2: #3A1A1C;
    --pin: #F2625A; --pin-2: #FF8E88; --route: #6AA5FF;
    --sea: #17405F; --sea-edge: #28597D; --land: #1A2733; --park: #1D3A2B; --hill-a: #1F2D33; --hill-b: rgba(31, 45, 51, 0); --river: #28597D; --rail: #5A6B7C;
    --art-sun: #FFE7CF; --art-city: rgba(255, 255, 255, .35); --art-sea: rgba(255, 255, 255, .14);
    --sh: 0 1px 2px rgba(0, 0, 0, .3), 0 6px 18px rgba(0, 0, 0, .25);
    --grad: linear-gradient(135deg, #2D8CE8 0%, #2A66C9 55%, #3D4DB8 100%);
    --hero: linear-gradient(160deg, #C9703F 0%, #B04A5A 40%, #3F55B0 100%);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --outer: #050B12; --bg: #0C1621; --surface: #142232; --surface-2: #1B2C3E; --surface-3: #243950;
  --ink: #EAF1F8; --ink-2: #A5B6C8; --ink-3: #6C8197; --line: #243950;
  --pri: #5AA2F5; --pri-2: #17304D; --pink: #FF7F8C; --accent: #FF8A64; --accent-2: #3A2218; --blue: #7DB4FF; --blue-2: #17304D;
  --ok: #4CCB8B; --ok-2: #123324; --warn: #F0B55A; --warn-2: #33280F; --bad: #FF7A7E; --bad-2: #3A1A1C;
  --pin: #F2625A; --pin-2: #FF8E88; --route: #6AA5FF;
  --sea: #17405F; --sea-edge: #28597D; --land: #1A2733; --park: #1D3A2B; --hill-a: #1F2D33; --hill-b: rgba(31, 45, 51, 0); --river: #28597D; --rail: #5A6B7C;
  --art-sun: #FFE7CF; --art-city: rgba(255, 255, 255, .35); --art-sea: rgba(255, 255, 255, .14);
  --sh: 0 1px 2px rgba(0, 0, 0, .3), 0 6px 18px rgba(0, 0, 0, .25);
  --grad: linear-gradient(135deg, #2D8CE8 0%, #2A66C9 55%, #3D4DB8 100%);
  --hero: linear-gradient(160deg, #C9703F 0%, #B04A5A 40%, #3F55B0 100%);
  color-scheme: dark;
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { margin: 0; }
body { background: var(--outer); color: var(--ink); font: 15px/1.5 var(--font); -webkit-font-smoothing: antialiased; word-break: keep-all; overflow-wrap: anywhere; }
body.locked { overflow: hidden; }
button, input, select { font: inherit; color: inherit; }
button { cursor: pointer; border: 0; background: none; padding: 0; }
:focus-visible { outline: 2.5px solid var(--pri); outline-offset: 2px; border-radius: 10px; }
.ic { width: 20px; height: 20px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
h1, h2, h3 { margin: 0; text-wrap: balance; }
small { font-size: 12.5px; }

.shell { position: relative; max-width: 520px; min-height: 100vh; margin: 0 auto; background: var(--bg); }
@media (min-width: 560px) { .shell { box-shadow: 0 0 0 1px var(--line), 0 20px 60px rgba(20, 27, 45, .08); } }
.scr { padding: 8px 18px 120px; }

/* 상단 바 */
.appbar { position: sticky; top: 0; z-index: 30; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 8px; min-height: 58px; padding: 8px 12px; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
.brand { display: flex; align-items: center; gap: 8px; font-weight: 800; font-size: 17px; letter-spacing: -.02em; padding-left: 6px; }
.logo { width: 26px; height: 26px; border-radius: 9px; background: var(--grad); position: relative; }
.logo::after { content: ''; position: absolute; left: 7px; right: 7px; top: 12px; height: 2.5px; border-radius: 2px; background: #fff; box-shadow: 0 -5px 0 #fff; }
.ab-t { display: flex; flex-direction: column; align-items: center; min-width: 0; font-weight: 800; font-size: 16px; }
.ab-t small { font-weight: 500; color: var(--ink-2); }
.ab-title { display: inline-flex; align-items: center; gap: 4px; font-weight: 800; font-size: 16px; max-width: 100%; }
.ab-title .ic { width: 14px; height: 14px; color: var(--ink-3); }
.ab-r { display: flex; gap: 6px; justify-content: flex-end; min-width: 40px; }
.ab-sp { display: block; }
.ib { display: inline-grid; place-items: center; width: 42px; height: 42px; border-radius: 14px; color: var(--ink); background: transparent; }
.ib:hover { background: var(--surface-2); }
.ib.sm { width: 36px; height: 36px; border-radius: 12px; }
.ib.xs { width: 28px; height: 28px; border-radius: 9px; }
.ib.xs .ic { width: 16px; height: 16px; }
.ib:disabled { opacity: .3; cursor: default; }
.savebtn { height: 36px; padding: 0 16px; border-radius: 999px; background: var(--pri); color: var(--pri-ink); font-weight: 700; font-size: 14px; display: inline-flex; align-items: center; gap: 4px; }
.savebtn .ic { width: 16px; height: 16px; stroke-width: 2.6; }
.savebtn.done { background: var(--surface-2); color: var(--ok); }
.prog { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; padding: 0 18px 6px; position: sticky; top: 58px; z-index: 29; background: color-mix(in srgb, var(--bg) 88%, transparent); }
.prog i { height: 4px; border-radius: 4px; background: var(--surface-3); }
.prog i.on { background: var(--pri); }

/* 버튼 */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px; padding: 0 16px; border-radius: 14px; font-weight: 700; font-size: 15px; transition: transform .12s, filter .15s; white-space: nowrap; }
.btn:active:not(:disabled) { transform: scale(.98); }
.btn.pri { background: var(--pri); color: var(--pri-ink); }
.btn.pri:hover:not(:disabled) { filter: brightness(1.05); }
.btn.pri:disabled { background: var(--surface-3); color: var(--ink-3); cursor: not-allowed; }
.btn.big { min-height: 56px; width: 100%; font-size: 17px; border-radius: 18px; }
.btn.big .ic { width: 22px; height: 22px; }
.btn.soft { background: var(--surface-2); color: var(--ink); }
.btn.soft:hover { background: var(--surface-3); }
.btn.ghost { background: transparent; color: var(--ink-2); }
.btn.sm { min-height: 34px; padding: 0 12px; font-size: 13.5px; border-radius: 11px; }
.btn .ic { width: 18px; height: 18px; }
.btn.danger { color: var(--bad); }
.btn.danger-fill { background: var(--bad); }
.row2 { display: flex; gap: 8px; }
.row2 > .btn { flex: 1; }
.cta { position: fixed; bottom: 0; left: 50%; transform: translateX(-50%); width: min(520px, 100%); z-index: 25; padding: 14px 18px calc(14px + env(safe-area-inset-bottom)); background: linear-gradient(to top, var(--bg) 70%, transparent); display: grid; gap: 10px; }

/* 공통 */
.card { background: var(--surface); border-radius: var(--r); padding: 16px; box-shadow: var(--sh); }
.card + .card { margin-top: 12px; }
.sec { font-size: 15px; font-weight: 800; margin: 26px 2px 10px; }
.sub { color: var(--ink-2); font-size: 13.5px; margin: 4px 0 12px; }
.h-xl { font-size: clamp(30px, 8vw, 36px); font-weight: 800; letter-spacing: -.03em; line-height: 1.2; }
.h-l { font-size: 26px; font-weight: 800; letter-spacing: -.02em; margin: 6px 2px 16px; }
.h-s { font-size: 16px; font-weight: 800; }
.chip { display: inline-flex; align-items: center; gap: 4px; font-size: 12.5px; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: var(--surface-2); color: var(--ink-2); }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.tag { display: inline-flex; align-items: center; gap: 3px; font-size: 11.5px; font-weight: 700; padding: 2px 8px; border-radius: 999px; background: var(--surface-2); color: var(--ink-2); white-space: nowrap; }
.tag .ic { width: 12px; height: 12px; stroke-width: 3; }
.tag.meal { background: var(--pri-2); color: var(--pri); }
.tag.walk { background: var(--ok-2); color: var(--ok); }
.tag.fast { background: var(--blue-2); color: var(--blue); }
.tag.cheap { background: var(--ok-2); color: var(--ok); }
.store-note { display: flex; align-items: center; justify-content: center; gap: 6px; color: var(--ink-3); font-size: 12.5px; margin: 22px 0 0; }
.store-note .ic { width: 14px; height: 14px; }
.fine { font-size: 12px; color: var(--ink-3); margin: 18px 4px 0; }
.note { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 12px 14px; border-radius: 16px; background: var(--surface-2); color: var(--ink-2); font-size: 14px; margin: 12px 0 0; }
.note > span { flex: 1; min-width: 160px; }
.note.bad { background: var(--bad-2); color: var(--bad); }
.note.ok { background: var(--ok-2); color: var(--ok); }
.warn-t { color: var(--warn) !important; font-weight: 700; }
.bad-t { color: var(--bad); }

/* 일러스트 */
.art { display: block; width: 100%; height: 100%; }
.a-sun { fill: var(--art-sun); opacity: .9; }
.a-hill { fill: rgba(255, 255, 255, .16); }
.a-city > * { fill: var(--art-city); }
.a-sea { fill: var(--art-sea); }
.a-wave { fill: none; stroke: rgba(255, 255, 255, .55); stroke-width: 2; stroke-linecap: round; }

/* 홈 (비어 있음) */
.home-empty { padding-top: 4px; }
.hero-card { height: 210px; border-radius: 28px; overflow: hidden; background: var(--grad); box-shadow: 0 12px 30px rgba(255, 90, 54, .28); margin-bottom: 26px; }
.kicker { font-family: var(--num); font-weight: 600; font-size: 13px; letter-spacing: .18em; color: var(--pri); margin: 0 0 10px; }
.lede { color: var(--ink-2); font-size: 15.5px; margin: 14px 0 20px; }
.feat-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
.feat-list li { display: flex; align-items: center; gap: 12px; background: var(--surface); border-radius: 16px; padding: 12px 14px; box-shadow: var(--sh); font-weight: 600; font-size: 14.5px; }
.feat-list .ic { width: 22px; height: 22px; padding: 7px; box-sizing: content-box; border-radius: 12px; background: var(--pri-2); color: var(--pri); }

/* 홈 (계획 있음) */
.trip { background: var(--surface); border-radius: 26px; overflow: hidden; box-shadow: var(--sh); }
.trip-top { position: relative; display: block; width: 100%; height: 200px; background: var(--grad); text-align: left; color: #fff; }
.trip-top .art { position: absolute; inset: 0; }
.trip-top::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 35%, rgba(90, 10, 30, .38)); }
.trip-in { z-index: 1; }
.trip-in { position: absolute; left: 20px; right: 20px; bottom: 18px; display: flex; flex-direction: column; gap: 4px; }
.dday { align-self: flex-start; font-family: var(--num); font-weight: 700; font-size: 14px; padding: 4px 12px; border-radius: 999px; background: rgba(255, 255, 255, .95); color: var(--pri); }
.dday.b-now { color: var(--ok); } .dday.b-past { color: var(--ink-2); }
.dday.sm { font-size: 12px; padding: 3px 9px; background: var(--pri-2); }
.dday.sm.b-now { background: var(--ok-2); } .dday.sm.b-past { background: var(--surface-2); }
.trip-t { font-size: 26px; font-weight: 800; letter-spacing: -.02em; text-shadow: 0 1px 8px rgba(120, 20, 20, .25); }
.trip-d { font-size: 14px; opacity: .95; }
.trip-stats { display: grid; grid-template-columns: repeat(3, 1fr); padding: 14px 8px; border-bottom: 1px solid var(--line); }
.trip-stats > div, .stats > * { display: flex; flex-direction: column; align-items: center; gap: 2px; text-align: center; }
.trip-stats small, .stats small { color: var(--ink-3); font-size: 12px; }
.trip-stats b, .stats b { font-family: var(--num); font-weight: 700; font-size: 16px; }
.trip-day { padding: 16px 18px 18px; }
.trip-day h3 { font-size: 15px; margin-bottom: 10px; }
.trip-day h3 span { color: var(--ink-3); font-weight: 600; font-size: 13px; margin-left: 4px; }
.mini { list-style: none; margin: 0 0 16px; padding: 0; display: grid; gap: 8px; }
.mini li { display: grid; grid-template-columns: 48px 32px 1fr; align-items: center; gap: 8px; font-size: 14.5px; font-weight: 600; }
.mini li b { font-family: var(--num); color: var(--ink-2); font-weight: 600; }
.mini .more { display: block; color: var(--ink-3); font-size: 13px; padding-left: 88px; font-weight: 500; }
.plist { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
.plist li { display: flex; align-items: center; gap: 4px; background: var(--surface); border-radius: 18px; box-shadow: var(--sh); padding-right: 6px; }
.prow { flex: 1; display: flex; align-items: center; gap: 12px; text-align: left; padding: 14px 6px 14px 14px; }
.pr-t { flex: 1; display: flex; flex-direction: column; }
.pr-t small { color: var(--ink-2); }
.prow > .ic { color: var(--ink-3); }

/* 카테고리 타일 */
.ct { display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 11px; flex: none; background: var(--surface-2); color: var(--ink-2); }
.ct .ic { width: 18px; height: 18px; }
.c-sight { --c: #3E63DD; } .c-food { --c: #E5484D; } .c-cafe { --c: #A35829; } .c-shop { --c: #8E4EC6; } .c-nature { --c: #2B9A66; } .c-onsen { --c: #E2780F; } .c-free { --c: #6F7A8B; } .c-bed { --c: #6F7A8B; }
.ct[class*="c-"] { background: color-mix(in srgb, var(--c) 13%, var(--surface)); color: var(--c); }
.chip[class*="c-"] { background: color-mix(in srgb, var(--c) 12%, var(--surface)); color: var(--c); }

/* 기간 */
.sel-sum { display: flex; align-items: center; gap: 10px; background: var(--surface); border-radius: 18px; padding: 14px 16px; box-shadow: var(--sh); margin-bottom: 12px; flex-wrap: wrap; }
.sel-sum > div { display: flex; flex-direction: column; }
.sel-sum small { color: var(--ink-3); }
.sel-sum b { font-size: 15.5px; }
.sel-sum > .ic { color: var(--ink-3); }
.sel-sum .pill { margin-left: auto; background: var(--pri); color: #fff; font-weight: 700; font-size: 13px; padding: 5px 12px; border-radius: 999px; }
.cal-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.cal-h b { font-family: var(--num); font-size: 17px; }
.wk, .grid { display: grid; grid-template-columns: repeat(7, 1fr); }
.wk span { text-align: center; font-size: 12px; color: var(--ink-3); padding: 4px 0 8px; }
.dc { height: 44px; display: grid; place-items: center; font-family: var(--num); font-weight: 500; font-size: 15.5px; position: relative; }
.dc span { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; position: relative; z-index: 1; }
.dc:hover:not(:disabled) span { background: var(--surface-2); }
.dc.sun { color: var(--bad); } .dc.sat { color: var(--blue); }
.dc.past { opacity: .3; cursor: default; }
.dc.today span::after { content: ''; position: absolute; bottom: 4px; width: 4px; height: 4px; border-radius: 50%; background: var(--pri); }
.dc.in { background: var(--pri-2); }
.dc.rs { background: linear-gradient(to right, transparent 50%, var(--pri-2) 50%); }
.dc.re { background: linear-gradient(to left, transparent 50%, var(--pri-2) 50%); }
.dc.s span, .dc.e span { background: var(--pri) !important; color: #fff; font-weight: 700; }
.hint-s { color: var(--ink-3); font-size: 13px; text-align: center; margin: 10px 0 0; }
.chips-sel { display: flex; flex-wrap: wrap; gap: 8px; }
.chips-sel.scroll { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin: 12px -18px 4px; padding: 0 18px; }
.chips-sel button { padding: 9px 16px; border-radius: 999px; background: var(--surface-2); font-weight: 700; font-size: 14px; color: var(--ink-2); white-space: nowrap; }
.chips-sel button.on { background: var(--ink); color: var(--bg); }
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 10px; }
.fld { display: flex; flex-direction: column; gap: 6px; font-size: 12.5px; color: var(--ink-2); font-weight: 700; }
.fld select, .fld input, .ed select, .ed input { min-height: 46px; border-radius: 14px; border: 0; background: var(--surface-2); padding: 0 12px; color: var(--ink); font-weight: 600; font-size: 15px; width: 100%; }

/* 지역 */
.map-card { position: relative; background: var(--surface); border-radius: 24px; overflow: hidden; box-shadow: var(--sh); }
.rmap { width: 100%; height: 330px; background: var(--land); touch-action: none; }
.rmap svg { display: block; width: 100%; height: 100%; }
.map-ctl { position: absolute; top: 10px; right: 10px; display: grid; gap: 6px; }
.map-ctl .ib { background: var(--surface); box-shadow: var(--sh); }
.map-cap { margin: 0; padding: 10px 14px 12px; font-size: 12.5px; color: var(--ink-3); }
.agrid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.acard { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 3px; text-align: left; padding: 14px 14px 12px; border-radius: 18px; background: var(--surface); box-shadow: var(--sh); border: 2px solid transparent; transition: border-color .15s; }
.acard b { font-size: 15.5px; padding-right: 26px; }
.acard small { color: var(--ink-2); font-size: 12.5px; line-height: 1.4; }
.ac-m { margin-top: 6px; font-size: 12px; font-weight: 700; color: var(--ink-3); }
.ac-k { position: absolute; top: 12px; right: 12px; width: 24px; height: 24px; border-radius: 50%; border: 2px solid var(--line); display: grid; place-items: center; }
.ac-k .ic { width: 14px; height: 14px; stroke-width: 3; }
.acard.on { border-color: var(--pri); background: color-mix(in srgb, var(--pri-2) 55%, var(--surface)); }
.acard.on .ac-k { background: var(--pri); border-color: var(--pri); color: #fff; }
.meter { background: var(--surface); border-radius: 16px; padding: 10px 14px; box-shadow: var(--sh); }
.m-t { display: flex; justify-content: space-between; gap: 8px; font-size: 13.5px; }
.m-t span { color: var(--ink-2); }
.bar { height: 6px; border-radius: 6px; background: var(--surface-3); margin-top: 8px; overflow: hidden; }
.bar i { display: block; height: 100%; border-radius: 6px; background: var(--ok); transition: width .25s; }
.bar i.over { background: var(--warn); }

/* 지도 공통 */
.sea { fill: var(--sea); }
.coast { fill: none; stroke: var(--sea-edge); stroke-width: 1.2; }
.land { fill: var(--land); stroke: var(--sea-edge); stroke-width: 1; }
.park { fill: var(--park); }
.hill-a { stop-color: var(--hill-a); } .hill-b { stop-color: var(--hill-b); }
.river { fill: none; stroke: var(--river); stroke-linecap: round; }
.rail { fill: none; stroke: var(--rail); }
.sline { fill: none; stroke-linecap: round; stroke-linejoin: round; opacity: .5; }
.st { fill: var(--surface); stroke: var(--ink-3); stroke-width: 1.4; }
.st-t { font-size: 10px; fill: var(--ink-3); paint-order: stroke; stroke: var(--land); stroke-width: 3px; }
.sea-t { fill: color-mix(in srgb, var(--sea-edge) 60%, var(--ink-3)); font-weight: 700; letter-spacing: .35em; text-anchor: middle; }
.sdot { fill: var(--ink-3); opacity: .4; }
.sdot.on { fill: var(--pri); opacity: .85; }
.apin { cursor: pointer; outline: none; }
.apin-hit { fill: transparent; }
.apin-c { fill: var(--surface); stroke: var(--ink); stroke-width: 2.5; }
.apin-d { fill: var(--ink); }
.apin-k { fill: none; stroke: #fff; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
.apin-t { font-size: 13px; font-weight: 800; text-anchor: middle; fill: var(--ink); paint-order: stroke; stroke: var(--land); stroke-width: 4px; stroke-linejoin: round; }
.apin:hover .apin-c, .apin:focus-visible .apin-c { stroke: var(--pri); stroke-width: 3.5; }
.apin.on .apin-c { fill: var(--pri); stroke: var(--pri); }
.rseg { fill: none; stroke-linejoin: round; }
.seg-halo { fill: none; stroke: var(--land); stroke-width: 8; stroke-linecap: round; stroke-linejoin: round; opacity: .9; }
.npin { cursor: pointer; outline: none; }
.npin circle { fill: var(--ink); stroke: var(--surface); stroke-width: 2.5; }
.npin text { fill: var(--bg); font-family: var(--num); font-size: 12px; font-weight: 700; text-anchor: middle; }
.npin.walkp circle { fill: var(--ok); }
.npin.on circle { fill: var(--pri); }
.npin.on text { fill: #fff; }
.npin .npin-l { fill: var(--ink); font-family: var(--font); font-size: 13px; paint-order: stroke; stroke: var(--land); stroke-width: 4px; }
.anc-pin rect { fill: var(--surface); stroke: var(--ink); stroke-width: 2; }
.anc-ic { fill: none; stroke: var(--ink); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
.corr { fill: none; stroke: var(--ok); opacity: .1; stroke-linecap: round; }
.rpin { cursor: pointer; }
.rpin circle { fill: var(--surface); stroke: var(--ok); stroke-width: 2.5; }
.rpin text { font-family: var(--num); font-size: 11.5px; font-weight: 700; text-anchor: middle; fill: var(--ok); }
.rpin.on circle { fill: var(--pri); stroke: var(--pri); }
.rpin.on text { fill: #fff; }
.ab-pin rect { fill: var(--ink); }
.ab-pin text { fill: var(--bg); font-size: 11.5px; font-weight: 700; text-anchor: middle; }

/* 계획 */
.days { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; margin: 0 -18px; padding: 4px 18px 12px; position: sticky; top: 58px; z-index: 20; background: var(--bg); }
.days::-webkit-scrollbar, .chips-sel.scroll::-webkit-scrollbar, .strip::-webkit-scrollbar { display: none; }
.days button { flex: none; display: flex; flex-direction: column; align-items: center; padding: 8px 16px; border-radius: 16px; background: var(--surface); box-shadow: var(--sh); min-width: 84px; }
.days b { font-size: 14px; } .days small { font-family: var(--num); color: var(--ink-3); font-size: 12px; }
.days button.on { background: var(--ink); color: var(--bg); }
.days button.on small { color: color-mix(in srgb, var(--bg) 70%, transparent); }
.daycard { background: var(--surface); border-radius: 22px; padding: 16px 16px 14px; box-shadow: var(--sh); }
.dc-h { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
.dc-h h2 { font-size: 22px; font-weight: 800; }
.dc-h small { color: var(--ink-2); }
.dc-h .ib { background: var(--surface-2); }
.stats { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); }
.stats b { font-size: 15px; }
.stats button b { color: var(--pri); }
.hint { display: flex; gap: 10px; align-items: flex-start; font-size: 13px; color: var(--ink-2); background: var(--surface); border-radius: 16px; padding: 12px 10px 12px 14px; margin-top: 12px; box-shadow: var(--sh); }
.hint > .ic { color: var(--ok); margin-top: 1px; }
.hint b { color: var(--ink); }
.banner { background: var(--surface); border-radius: 20px; padding: 14px 16px; margin-top: 12px; box-shadow: 0 0 0 2px var(--ok), var(--sh); }
.bn-h { display: flex; gap: 8px; align-items: center; color: var(--ok); }
.bn-h b { color: var(--ink); }
.banner ul { list-style: none; margin: 10px 0 12px; padding: 0; display: grid; gap: 6px; font-size: 14px; }
.banner li { display: flex; gap: 8px; align-items: flex-start; }
.banner li b { margin-right: 4px; }
.dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--ink-3); margin-top: 7px; }
.dot.d-ok { background: var(--ok); } .dot.d-warn { background: var(--warn); }

.tl { list-style: none; margin: 16px 0 0; padding: 0; }
.tl > li { display: grid; grid-template-columns: 50px minmax(0, 1fr); column-gap: 10px; }
.tm { display: flex; flex-direction: column; align-items: flex-end; padding-top: 14px; font-family: var(--num); }
.tm b { font-size: 16px; font-weight: 700; }
.tm span { font-size: 12px; color: var(--ink-3); }
.anc .tm { padding-top: 11px; }
.anc-c { display: flex; align-items: center; gap: 10px; text-align: left; width: 100%; padding: 10px 14px; border-radius: 16px; background: var(--surface-2); font-weight: 700; font-size: 14px; }
.anc-c > span { flex: 1; display: flex; flex-direction: column; }
.anc-c small { color: var(--ink-2); font-weight: 500; }
.anc-c .chev { color: var(--ink-3); width: 16px; height: 16px; }
.leg { min-height: 50px; }
.leg .rail { grid-column: 1; justify-self: end; width: 0; margin-right: 18px; border-left: 3px solid var(--m); min-height: 100%; }
.leg.m-walk .rail { border-left-style: dotted; border-left-width: 4px; }
.leg.m-bus .rail, .leg.m-taxi .rail, .leg.m-car .rail, .leg.m-ferry .rail { border-left-style: dashed; }
.leg.none .rail { border-left: 2px dotted var(--line); min-height: 14px; }
.lchip { grid-column: 2; align-self: center; display: grid; grid-template-columns: auto 1fr auto; grid-template-areas: "i m c" "i l c"; column-gap: 10px; align-items: center; width: 100%; text-align: left; margin: 6px 0; padding: 7px 10px 7px 7px; border-radius: 14px; background: color-mix(in srgb, var(--m) 8%, var(--bg)); border: 1px solid color-mix(in srgb, var(--m) 18%, transparent); }
.lchip .mi { grid-area: i; }
.lc-m { grid-area: m; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 14px; }
.lc-m em { font-style: normal; font-family: var(--num); font-weight: 700; color: var(--ink); background: var(--surface); border-radius: 8px; padding: 0 7px; font-size: 13px; }
.lc-m .mine { font-style: normal; font-size: 11px; font-weight: 700; color: var(--pri); }
.lc-l { grid-area: l; font-size: 12.5px; color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lchip .chev { grid-area: c; width: 16px; height: 16px; color: var(--ink-3); }
.mi { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 12px; background: var(--m); color: #fff; flex: none; }
.mi .ic { width: 20px; height: 20px; stroke-width: 2.2; }
.mi.sm { width: 30px; height: 30px; border-radius: 10px; }
.mi.sm .ic { width: 17px; height: 17px; }
.mi.xs { width: 22px; height: 22px; border-radius: 7px; }
.mi.xs .ic { width: 13px; height: 13px; }
.sc { background: var(--surface); border-radius: 20px; padding: 12px 14px 14px; box-shadow: var(--sh); border: 2px solid transparent; transition: border-color .15s; }
.stop.sel .sc { border-color: var(--ink); }
.sc-hit { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; }
.sc-hit .ct { width: 42px; height: 42px; border-radius: 14px; }
.sc-hit .ct .ic { width: 22px; height: 22px; }
.sc-t { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.sc-t b { font-size: 16.5px; font-weight: 800; line-height: 1.3; }
.sc-t small { color: var(--ink-3); font-size: 12.5px; }
.num { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--surface-2); color: var(--ink-2); font-family: var(--num); font-weight: 700; font-size: 12.5px; flex: none; }
.stop.sel .num { background: var(--pri); color: #fff; }
.tags { display: flex; flex-wrap: wrap; gap: 5px; margin: 10px 0 0; }
.desc { margin: 8px 0 0; font-size: 13.5px; color: var(--ink-2); }
.warn { display: flex; align-items: center; gap: 6px; margin: 8px 0 0; font-size: 12.5px; font-weight: 700; color: var(--warn); background: var(--warn-2); padding: 6px 10px; border-radius: 10px; }
.warn .ic { width: 15px; height: 15px; }
.memo { margin: 8px 0 0; font-size: 13px; padding: 8px 10px; border-radius: 10px; background: var(--surface-2); }
.edit { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--line); display: grid; gap: 12px; }
.ed { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 13.5px; font-weight: 700; color: var(--ink-2); }
.ed.col { flex-direction: column; align-items: stretch; }
.ed select { width: auto; min-height: 40px; font-size: 14px; }
.stp { display: flex; align-items: center; gap: 6px; }
.stp button { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--surface-2); color: var(--ink); }
.stp button:disabled { opacity: .35; }
.stp b { font-family: var(--num); min-width: 72px; text-align: center; color: var(--ink); }
.empty-c { text-align: center; }
.empty-c p { margin: 4px 0 10px; color: var(--ink-2); }
.day-act { margin-top: 16px; }
.parked { margin-top: 16px; padding: 0; }
.parked summary { list-style: none; display: flex; align-items: center; gap: 10px; padding: 14px 16px; cursor: pointer; }
.parked summary::-webkit-details-marker { display: none; }
.parked summary b { flex: 1; }
.parked summary .chev { color: var(--ink-3); transition: transform .2s; }
.parked[open] summary .chev { transform: rotate(180deg); }
.cnt { font-family: var(--num); font-weight: 700; font-size: 12.5px; background: var(--pri); color: #fff; border-radius: 999px; padding: 1px 9px; }
.parked .sub { padding: 0 16px; margin-top: 0; }
.parked ul { list-style: none; margin: 0; padding: 0 8px 10px 16px; }
.parked li { display: flex; align-items: center; gap: 8px; padding: 10px 0; border-top: 1px solid var(--line); }
.pk-t { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.pk-t small { color: var(--ink-3); }

/* 지도 탭 */
.mapfull { position: relative; margin: 0 -18px; }
.dmap { position: relative; width: 100%; height: calc(100vh - 218px - env(safe-area-inset-bottom)); min-height: 380px; background: var(--land); }
.dmap svg, .wmap svg { display: block; width: 100%; height: 100%; }
.map-note2 { position: absolute; left: 12px; right: 12px; top: 12px; margin: 0; font-size: 12.5px; background: var(--surface); border-radius: 12px; padding: 8px 12px; color: var(--ink-2); box-shadow: var(--sh); }
.legend { position: absolute; left: 12px; top: 12px; display: flex; flex-wrap: wrap; gap: 6px; max-width: calc(100% - 24px); }
.map-note2 ~ .legend, .legend:has(~ .map-note2) { top: 56px; }
.legend > span { display: flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 700; background: var(--surface); padding: 3px 9px 3px 3px; border-radius: 999px; box-shadow: var(--sh); }
.strip { position: absolute; left: 0; right: 0; bottom: 14px; display: flex; gap: 8px; overflow-x: auto; padding: 0 12px; scroll-snap-type: x mandatory; scrollbar-width: none; }
.sp { flex: none; scroll-snap-align: center; display: flex; align-items: center; gap: 10px; text-align: left; background: var(--surface); border-radius: 16px; padding: 10px 14px 10px 10px; box-shadow: 0 6px 20px rgba(20, 27, 45, .15); max-width: 240px; border: 2px solid transparent; }
.sp > span:last-child { display: flex; flex-direction: column; min-width: 0; }
.sp b { font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sp small { color: var(--ink-3); font-family: var(--num); }
.sp.on { border-color: var(--pri); }
.sp.on .num { background: var(--pri); color: #fff; }

/* 교통비 탭 */
.fare-hero { border-radius: 24px; padding: 20px 20px 18px; background: var(--grad); color: #fff; box-shadow: 0 12px 30px rgba(255, 90, 54, .25); margin-top: 6px; }
.fare-hero small { opacity: .9; font-weight: 600; }
.fh-n { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin: 4px 0 6px; }
.fh-n b { font-family: var(--num); font-size: 38px; font-weight: 700; letter-spacing: -.02em; }
.fh-n span { font-family: var(--num); font-size: 16px; opacity: .9; }
.fare-hero p { margin: 0; font-size: 14px; }
.recs-l { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
.recs-l li { display: flex; gap: 12px; align-items: flex-start; background: var(--surface); border-radius: 18px; padding: 14px; box-shadow: var(--sh); }
.rk { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; flex: none; }
.rk .ic { width: 16px; height: 16px; stroke-width: 3; }
.recs-l .ok .rk { background: var(--ok-2); color: var(--ok); }
.recs-l .no .rk { background: var(--surface-2); color: var(--ink-3); }
.rb { flex: 1; display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.rb b { font-size: 14.5px; }
.rb small { color: var(--ink-2); line-height: 1.45; }
.recs-l em { font-style: normal; font-family: var(--num); font-weight: 700; font-size: 14px; white-space: nowrap; }
.recs-l .ok em { color: var(--ok); } .recs-l .no em { color: var(--ink-3); }
.fday { display: grid; gap: 8px; }
.fd { display: block; width: 100%; text-align: left; background: var(--surface); border-radius: 18px; padding: 14px; box-shadow: var(--sh); }
.fd-h { display: flex; align-items: baseline; gap: 8px; margin-bottom: 8px; }
.fd-h small { color: var(--ink-3); font-family: var(--num); }
.fd-n { margin-left: auto; font-family: var(--num); font-weight: 700; font-size: 18px; }
.fd-how, .fd-tx { display: flex; align-items: center; gap: 6px; margin: 8px 0 0; font-size: 12.5px; color: var(--ink-2); }
.fd-how { color: var(--ok); font-weight: 700; }
.fd-how .ic, .fd-tx .ic { width: 15px; height: 15px; }
.fare-info dl { margin: 0; display: grid; grid-template-columns: 70px 1fr; gap: 10px 12px; font-size: 13.5px; }
.fare-info dt { font-weight: 800; }
.fare-info dd { margin: 0; color: var(--ink-2); }
.rate { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: var(--ink); }
.rate input { width: 84px; min-height: 36px; border-radius: 10px; border: 0; background: var(--surface-2); padding: 0 10px; font-family: var(--num); font-weight: 700; }

/* 하단 탭 */
.tabbar { position: fixed; bottom: 0; left: 50%; transform: translateX(-50%); width: min(520px, 100%); z-index: 26; display: grid; grid-template-columns: repeat(3, 1fr); padding: 6px 10px calc(8px + env(safe-area-inset-bottom)); background: color-mix(in srgb, var(--surface) 92%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-top: 1px solid var(--line); }
.tabbar button { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 6px 0; font-size: 12px; font-weight: 700; color: var(--ink-3); border-radius: 12px; }
.tabbar button .ic { width: 23px; height: 23px; }
.tabbar button.on { color: var(--pri); }
.plan { padding-bottom: 110px; }
.plan.t-map { padding-bottom: 0; }

/* 바텀시트 */
.scrim { position: fixed; inset: 0; background: rgba(10, 14, 22, .45); z-index: 40; animation: fade .15s; }
.sheet { position: fixed; z-index: 41; left: 50%; bottom: 0; transform: translateX(-50%); width: min(520px, 100%); max-height: 90vh; overflow-y: auto; background: var(--bg); border-radius: 26px 26px 0 0; padding: 0 18px calc(18px + env(safe-area-inset-bottom)); animation: up .22s ease-out; box-shadow: 0 -10px 40px rgba(10, 14, 22, .2); overscroll-behavior: contain; }
@keyframes fade { from { opacity: 0; } }
@keyframes up { from { transform: translate(-50%, 40px); opacity: 0; } }
@media (prefers-reduced-motion: reduce) { .sheet, .scrim, .toast { animation: none; } .bar i, .sc, .acard { transition: none; } }
.handle { display: block; width: 40px; height: 5px; border-radius: 5px; background: var(--surface-3); margin: 10px auto 0; }
.sh-h { position: sticky; top: 0; z-index: 2; background: var(--bg); display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding: 12px 0 12px; }
.sh-h h2 { font-size: 20px; font-weight: 800; }
.sh-h p { margin: 3px 0 0; font-size: 13.5px; color: var(--ink-2); }
.sh-h .ib { background: var(--surface-2); }
.opts { display: grid; gap: 8px; }
.opt { display: flex; gap: 12px; align-items: flex-start; text-align: left; background: var(--surface); border-radius: 18px; padding: 12px; box-shadow: var(--sh); border: 2px solid transparent; }
.opt.on { border-color: var(--ink); }
.opt.off { opacity: .5; cursor: not-allowed; }
.ob { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0; }
.o1 { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.o1 > b { font-size: 15.5px; }
.o2 { display: flex; align-items: baseline; gap: 10px; }
.o2 b { font-family: var(--num); font-size: 20px; font-weight: 700; }
.o2 em { font-style: normal; font-family: var(--num); font-weight: 700; font-size: 16px; color: var(--pri); }
.ol { font-size: 12.5px; color: var(--ink-2); }
.osteps { margin: 6px 0 0; padding-left: 18px; font-size: 12.5px; color: var(--ink-2); display: grid; gap: 2px; }
.onote { font-size: 12.5px; color: var(--warn); font-weight: 700; }
.walk { margin-top: 18px; }
.walk h3 { display: flex; align-items: center; gap: 8px; font-size: 17px; }
.walk h3 .ic { color: var(--ok); }
.wmap { height: 230px; border-radius: 18px; overflow: hidden; background: var(--land); box-shadow: var(--sh); }
.recs { display: grid; gap: 8px; margin-top: 10px; }
.rec { display: flex; gap: 12px; align-items: flex-start; text-align: left; background: var(--surface); border-radius: 18px; padding: 12px; box-shadow: var(--sh); border: 2px solid transparent; }
.rec.on { border-color: var(--pri); background: color-mix(in srgb, var(--pri-2) 50%, var(--surface)); }
.rec .rb b { display: flex; align-items: center; gap: 6px; font-size: 15px; }
.rn { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--ok); color: var(--ok); font-family: var(--num); font-size: 11px; font-weight: 700; flex: none; }
.rec.on .rn { background: var(--pri); border-color: var(--pri); color: #fff; }
.rm { color: var(--ink-3) !important; font-family: var(--num); }
.rec .tick { width: 26px; height: 26px; border-radius: 9px; border: 2px solid var(--line); display: grid; place-items: center; flex: none; }
.rec.on .tick { background: var(--pri); border-color: var(--pri); color: #fff; }
.rec .tick .ic { width: 15px; height: 15px; stroke-width: 3; }
.sh-foot { position: sticky; bottom: calc(-18px - env(safe-area-inset-bottom)); display: flex; gap: 8px; padding: 14px 0 calc(18px + env(safe-area-inset-bottom)); margin-top: 12px; background: linear-gradient(transparent, var(--bg) 22%); }
.sh-foot .btn { flex: 1; min-height: 52px; }
.sh-foot .btn.pri { flex: 2; }
.sh-foot.col { flex-direction: column; position: static; background: none; padding-bottom: 4px; }
.search { display: flex; align-items: center; gap: 8px; background: var(--surface); border-radius: 14px; padding: 0 14px; box-shadow: var(--sh); }
.search input { border: 0; flex: 1; min-height: 48px; padding: 0; background: none; outline: none; font-size: 15px; }
.search .ic { color: var(--ink-3); }
.add-list ul { list-style: none; margin: 0; padding: 0; }
.add-list li { display: flex; align-items: center; gap: 12px; padding: 10px 2px; border-bottom: 1px solid var(--line); }
.al-t { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.al-t small { color: var(--ink-3); }
.custom { margin-top: 14px; }
.custom summary { list-style: none; display: flex; align-items: center; gap: 8px; font-weight: 700; cursor: pointer; }
.custom summary::-webkit-details-marker { display: none; }
.custom summary .chev { margin-left: auto; color: var(--ink-3); }
.custom .btn { width: 100%; margin-top: 12px; }
.toasts { position: fixed; left: 50%; bottom: 96px; transform: translateX(-50%); z-index: 60; width: max-content; max-width: calc(min(520px, 100%) - 32px); }
.toast { display: flex; align-items: center; gap: 12px; background: var(--ink); color: var(--bg); padding: 11px 10px 11px 16px; border-radius: 16px; font-size: 14px; box-shadow: 0 10px 30px rgba(0, 0, 0, .25); animation: up2 .2s; }
@keyframes up2 { from { transform: translateY(10px); opacity: 0; } }
.toast button { color: var(--pri); font-weight: 800; font-size: 14px; padding: 4px 8px; }
.v-home .toasts, .v-dates .toasts, .v-areas .toasts { bottom: 110px; }
@media (max-width: 360px) { .agrid { grid-template-columns: 1fr; } .stats b { font-size: 13.5px; } }


/* ===== 새 테마·화면 (위시리스트 · 구글맵풍 지도 · 교통비 상세보기 · 실시간 맞추기) ===== */
:root { --toast-act: #8CC4FF; }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --toast-act: #1F6FD0; } }
:root[data-theme="dark"] { --toast-act: #1F6FD0; }
.toast button { color: var(--toast-act); }

body { background: var(--outer); }
.shell { background: linear-gradient(180deg, color-mix(in srgb, var(--pri) 10%, var(--bg)) 0, var(--bg) 340px); }
.appbar, .prog, .days { background: color-mix(in srgb, var(--bg) 84%, transparent); }
.logo, .hero-card, .trip-top { background: var(--hero); }
.logo { background: var(--grad); }
.hero-card { box-shadow: 0 12px 30px rgba(255, 112, 100, .28); }
.trip { border: 1px solid color-mix(in srgb, var(--line) 70%, transparent); }
.fare-hero { background: var(--grad); box-shadow: 0 12px 30px rgba(31, 122, 224, .28); }
.btn.pri:not(:disabled), .savebtn { background: var(--grad); }
.btn.pri:disabled { background: var(--surface-3); }
.card, .daycard, .sc, .fd, .recs-l li, .acard, .hint, .banner, .plist li, .search, .opt, .rec { border: 1px solid color-mix(in srgb, var(--line) 55%, transparent); }
.daycard { background: linear-gradient(160deg, color-mix(in srgb, var(--pri) 9%, var(--surface)) 0%, var(--surface) 62%); }
.chips-sel button.on, .days button.on { background: var(--pri); color: #fff; }
.days button.on small { color: rgba(255, 255, 255, .82); }
.days button { position: relative; }
.days .dn { position: absolute; top: 5px; right: 8px; font-style: normal; font-family: var(--num); font-size: 11px; font-weight: 700; color: var(--pri); }
.days .dn:empty { display: none; }
.days button.on .dn { color: #fff; }
.tabbar { grid-template-columns: repeat(4, 1fr); background: color-mix(in srgb, var(--surface) 92%, transparent); border-top: 1px solid var(--line); }
.tabbar button.on { color: var(--pri); }
.tabbar button.on .ic { fill: color-mix(in srgb, var(--pri) 16%, transparent); }
.tag.meal { background: var(--accent-2); color: var(--accent); }
.tag.day { background: var(--pri-2); color: var(--pri); }
.tag.live { background: var(--accent-2); color: var(--accent); }
.tag.live .ic { width: 12px; height: 12px; stroke-width: 2.6; }
.stop.sel .sc { border-color: var(--pri); }
.stop.sel .num { background: var(--pri); }
.sec { color: var(--ink); }

/* 공통 조각 */
.lnk { display: inline-flex; align-items: center; gap: 4px; color: var(--pri); font-weight: 700; font-size: 13.5px; padding: 6px 4px; border-radius: 8px; }
.lnk .ic { width: 16px; height: 16px; stroke-width: 2.4; }
.lnk.center { display: flex; justify-content: center; margin: 14px auto 0; }
.btn.live { background: var(--accent-2); color: var(--accent); }
.btn.live:hover { filter: brightness(.97); }
.lede-s { margin: 4px 2px 14px; color: var(--ink-2); font-size: 14px; }
.lede-s b { color: var(--ink); }
.empty-line { display: flex; gap: 8px; align-items: center; margin: 0 0 14px; color: var(--ink-2); font-size: 14px; }
.empty-line .ic { color: var(--accent); }
.chips-sel.sm { margin-top: 4px; }
.chips-sel.sm button { padding: 6px 13px; font-size: 13px; background: var(--surface); box-shadow: var(--sh); }
.chips-sel.sm button.on { background: var(--ink); color: var(--bg); }
.search { margin-top: 12px; }
.meter { margin-bottom: 8px; }
.meter .m-t { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 13.5px; }
.meter .m-t span { color: var(--ink-2); }

/* 위시리스트 */
.wgrp { margin-top: 18px; }
.wg-h { display: flex; align-items: flex-end; justify-content: space-between; gap: 10px; margin: 0 2px 8px; }
.wg-h h3 { font-size: 16px; font-weight: 800; }
.wg-h small { color: var(--ink-3); }
.wl { display: grid; gap: 8px; }
.wrow { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; background: var(--surface); border-radius: 18px; padding: 11px 12px; box-shadow: var(--sh); border: 2px solid transparent; transition: border-color .12s, background .12s; }
.wrow .ct { width: 40px; height: 40px; border-radius: 13px; }
.wrow .ct .ic { width: 21px; height: 21px; }
.wrow.on { border-color: var(--pri); background: color-mix(in srgb, var(--pri-2) 60%, var(--surface)); }
.wr-t { flex: 1; display: flex; flex-direction: column; min-width: 0; gap: 1px; }
.wr-t b { font-size: 15.5px; font-weight: 800; line-height: 1.3; }
.wr-t small { color: var(--ink-3); font-size: 12.5px; }
.wr-d { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink-2) !important; }
.wr-k { flex: none; width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--surface-3); display: grid; place-items: center; color: #fff; }
.wrow.on .wr-k { background: var(--pri); border-color: var(--pri); }
.wr-k .ic { width: 15px; height: 15px; stroke-width: 3.2; }
.seg { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; padding: 4px; background: var(--surface-3); border-radius: 14px; margin: 4px 0 4px; }
.seg button { padding: 10px 0; border-radius: 11px; font-weight: 700; font-size: 14px; color: var(--ink-2); }
.seg button.on { background: var(--surface); color: var(--ink); box-shadow: var(--sh); }
.wishhead { margin: 6px 2px 10px; }
.wishhead h2 { font-size: 22px; font-weight: 800; }
.wishhead p { margin: 2px 0 0; color: var(--ink-2); font-size: 13.5px; }
.sdot { fill: color-mix(in srgb, var(--ink-3) 55%, transparent); }
.sdot.on { fill: var(--pri); stroke: #fff; stroke-width: 1.2; }
.apin-c { stroke: var(--ink); }
.apin.on .apin-c { fill: var(--pri); stroke: var(--pri); }
.apin-n { fill: #fff; font-family: var(--num); font-weight: 700; font-size: 14px; text-anchor: middle; }
.map-cap { text-align: center; }

/* 일정 */
.stats.s3 { grid-template-columns: repeat(3, 1fr); }
.farerow { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 12px; padding: 10px 12px; border-radius: 14px; background: color-mix(in srgb, var(--pri) 8%, var(--surface-2)); }
.fr-n { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
.fr-n small { color: var(--ink-2); font-weight: 700; }
.fr-n b { font-family: var(--num); font-size: 22px; font-weight: 700; color: var(--pri); }
.fr-n span { font-family: var(--num); font-size: 13px; color: var(--ink-3); }
.fdet { margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--line); display: grid; gap: 10px; }
.fl { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
.fl li { display: flex; align-items: center; gap: 10px; }
.fl .mi { flex: none; }
.fl-t { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.fl-t b { font-size: 13.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fl-t small { color: var(--ink-3); font-size: 12px; }
.fl em { font-style: normal; font-family: var(--num); font-weight: 700; font-size: 14.5px; }
.livebar { display: flex; align-items: center; gap: 10px; margin-top: 12px; padding: 12px 12px 12px 14px; border-radius: 16px; background: var(--accent-2); color: var(--ink); }
.livebar > .ic { color: var(--accent); }
.livebar > span { flex: 1; display: flex; flex-direction: column; font-size: 14px; }
.livebar small { color: var(--ink-2); font-size: 12px; line-height: 1.4; margin-top: 2px; }
.anc-w { display: flex; align-items: center; gap: 8px; min-width: 0; }
.anc-w .anc-c { flex: 1; min-width: 0; width: auto; }
.nowbtn { flex: none; display: inline-flex; align-items: center; gap: 4px; padding: 0 12px; height: 40px; border-radius: 14px; background: var(--accent-2); color: var(--accent); font-weight: 800; font-size: 13px; }
.nowbtn .ic { width: 15px; height: 15px; stroke-width: 2.6; }
.lchip { background: color-mix(in srgb, var(--m) 9%, var(--surface)); }
.lchip.gone { outline: 2px solid var(--bad); }
.lc-l .dep { color: var(--pri); font-family: var(--num); font-weight: 700; }
.ed small { font-weight: 600; color: var(--ink-3); margin-left: 4px; font-family: var(--num); }
.ed-h { font-weight: 500 !important; margin: 0 !important; font-family: var(--font) !important; }
.empty-day { text-align: center; margin-top: 14px; padding: 28px 20px 22px; }
.ed-ic { width: 56px; height: 56px; border-radius: 20px; margin: 0 auto 12px; display: grid; place-items: center; background: var(--accent-2); color: var(--accent); }
.ed-ic .ic { width: 28px; height: 28px; }
.empty-day h3 { font-size: 19px; font-weight: 800; }
.empty-day p { color: var(--ink-2); font-size: 14px; margin: 8px 0 16px; }
.tips { margin-top: 16px; padding: 0; }
.tips summary { list-style: none; display: flex; align-items: center; gap: 10px; padding: 14px 16px; cursor: pointer; }
.tips summary::-webkit-details-marker { display: none; }
.tips summary b { flex: 1; }
.tips summary .chev { color: var(--ink-3); transition: transform .2s; }
.tips[open] summary .chev { transform: rotate(180deg); }
.tips .recs-l, .tips .fare-info { padding: 0 14px 14px; }
.tips .recs-l li { box-shadow: none; background: var(--surface-2); }
.fd-s { margin: 0 0 6px; color: var(--ink-2); font-size: 13px; }
.fd-n.none { color: var(--ink-3); }

/* 시트: 고르기 · 시간 맞추기 · 가격 상세 */
.sheet.s-pick { display: flex; flex-direction: column; overflow: hidden; height: min(92vh, 760px); max-height: 92vh; padding-bottom: 0; }
.sheet.s-pick .sh-h { position: static; flex: none; }
.sheet.s-pick .search, .sheet.s-pick .chips-sel { flex: none; }
.pk-list { flex: 1; min-height: 0; overflow-y: auto; padding: 0 0 14px; margin: 0 -18px; padding-inline: 18px; overscroll-behavior: contain; }
.pk-foot { flex: none; margin: 0 -18px; padding: 10px 18px calc(14px + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1px solid var(--line); box-shadow: 0 -8px 24px rgba(15, 36, 56, .08); }
.pk-foot .sh-foot { position: static; padding: 10px 0 0; margin: 0; background: none; }
.pk-hint { display: flex; align-items: center; gap: 8px; margin: 0; color: var(--ink-2); font-size: 13.5px; }
.pk-hint .ic { color: var(--pri); }
.pk-ord { display: flex; flex-wrap: wrap; gap: 4px 2px; align-items: center; font-size: 12.5px; font-weight: 700; }
.pk-ord .oc { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px 3px 4px; border-radius: 999px; background: var(--pri-2); color: var(--pri); }
.pk-ord .oc i { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: var(--pri); color: #fff; font-style: normal; font-family: var(--num); font-size: 11px; }
.pk-ord .ar { color: var(--ink-3); padding: 0 2px; }
.pk-st { display: grid; grid-template-columns: repeat(4, 1fr); margin: 10px 0 6px; text-align: center; }
.pk-st div { display: flex; flex-direction: column; }
.pk-st small { color: var(--ink-3); font-size: 11.5px; }
.pk-st b { font-family: var(--num); font-size: 15.5px; font-weight: 700; }
.pk-w, .pk-ok { display: flex; align-items: center; gap: 6px; margin: 0; font-size: 12.5px; font-weight: 700; }
.pk-w { color: var(--bad); } .pk-ok { color: var(--ok); }
.pk-w .ic, .pk-ok .ic { width: 15px; height: 15px; }
.tgrid { display: grid; gap: 16px; margin-top: 6px; }
.tfld { display: flex; flex-direction: column; gap: 6px; }
.tfld label { font-size: 13px; font-weight: 800; color: var(--ink-2); }
.tfld small { color: var(--ink-3); font-size: 12.5px; line-height: 1.4; }
.trow { display: flex; gap: 8px; }
.trow input { flex: 1; min-width: 0; min-height: 52px; border-radius: 14px; border: 2px solid transparent; background: var(--surface); box-shadow: var(--sh); padding: 0 14px; font-family: var(--num); font-size: 24px; font-weight: 700; color: var(--ink); }
.trow input:focus { outline: none; border-color: var(--pri); }
.trow .btn { min-height: 52px; }
.optw { display: grid; gap: 4px; }
.optw > .lnk { justify-self: end; margin-right: 6px; }
.ofd { margin: 0 4px 4px; padding: 10px 14px; border-radius: 14px; background: var(--surface-2); display: grid; gap: 4px; font-size: 13px; }
.ofd div { display: flex; justify-content: space-between; gap: 10px; }
.ofd b { font-family: var(--num); }
.onote.dep { color: var(--pri); font-weight: 700; display: flex; align-items: center; gap: 4px; }
.onote.dep .ic { width: 13px; height: 13px; stroke-width: 2.6; }

/* ===== 지도 탭 (구글맵처럼) ===== */
.plan.t-map { padding: 0; }
.mapfull { position: relative; margin: 0; height: calc(100vh - 58px - 66px - env(safe-area-inset-bottom)); height: calc(100dvh - 58px - 66px - env(safe-area-inset-bottom)); min-height: 460px; overflow: hidden; background: var(--land); }
.dmap { position: absolute; inset: 0; width: 100%; height: 100%; background: var(--land); touch-action: none; cursor: grab; user-select: none; -webkit-user-select: none; }
.dmap:active { cursor: grabbing; }
.dmap svg { display: block; width: 100%; height: 100%; }
.map-top { position: absolute; left: 0; right: 0; top: 0; z-index: 5; padding: 10px 12px 0; pointer-events: none; display: grid; gap: 8px; }
.map-top > * { pointer-events: auto; }
.gsearch { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; height: 50px; padding: 0 16px; border-radius: 26px; background: var(--surface); box-shadow: 0 2px 6px rgba(15, 36, 56, .18), 0 6px 20px rgba(15, 36, 56, .12); }
.gsearch > .ic { color: var(--ink-2); }
.gsearch > .ic:last-child { color: var(--pin); }
.gsearch > span { flex: 1; display: flex; flex-direction: column; line-height: 1.2; min-width: 0; }
.gsearch b { font-size: 14.5px; }
.gsearch small { color: var(--ink-3); font-size: 12px; }
.mchips { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 2px 0 4px; }
.mchips::-webkit-scrollbar { display: none; }
.mchip { flex: none; display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 14px; border-radius: 18px; background: var(--surface); color: var(--ink); font-weight: 700; font-size: 13.5px; box-shadow: 0 1px 4px rgba(15, 36, 56, .22); }
.mchip small { font-family: var(--num); color: var(--ink-3); font-weight: 600; font-size: 12px; }
.mchip.on { background: var(--pri); color: #fff; }
.mchip.on small { color: rgba(255, 255, 255, .85); }
.map-ctl2 { position: absolute; right: 12px; top: 138px; z-index: 5; display: grid; gap: 10px; }
.mbtn { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--surface); color: var(--ink); box-shadow: 0 1px 5px rgba(15, 36, 56, .28); }
.mbtn:active { background: var(--surface-2); }
.mbtn .ic { width: 22px; height: 22px; }
.map-note2 { position: absolute; left: 12px; right: 70px; top: 138px; margin: 0; z-index: 4; font-size: 12.5px; background: var(--surface); border-radius: 12px; padding: 8px 12px; color: var(--ink-2); box-shadow: var(--sh); }
.map-empty { position: absolute; left: 12px; right: 12px; bottom: 14px; z-index: 6; background: var(--surface); border-radius: 22px; padding: 16px 16px 16px; box-shadow: 0 -2px 18px rgba(15, 36, 56, .18); display: grid; gap: 6px; }
.map-empty p { margin: 0 0 6px; color: var(--ink-2); font-size: 13.5px; }
.msheet { position: absolute; left: 0; right: 0; bottom: 0; z-index: 6; background: var(--surface); border-radius: 24px 24px 0 0; box-shadow: 0 -4px 22px rgba(15, 36, 56, .2); padding: 0 0 12px; max-height: 66%; display: flex; flex-direction: column; }
.ms-h { display: flex; align-items: center; gap: 10px; width: 100%; text-align: left; padding: 22px 18px 10px; position: relative; flex: none; }
.ms-h .grab { position: absolute; left: 50%; top: 8px; width: 38px; height: 5px; border-radius: 5px; background: var(--surface-3); transform: translateX(-50%); }
.ms-sum { flex: 1; display: flex; flex-direction: column; line-height: 1.3; }
.ms-sum b { font-size: 16px; font-weight: 800; }
.ms-sum small { color: var(--ink-2); font-size: 12.5px; }
.ms-h .chev { color: var(--ink-3); }
.msheet .strip { position: static; padding: 0 14px 4px; }
.msheet .sp { box-shadow: none; background: var(--surface-2); border: 2px solid transparent; }
.msheet .sp.on { border-color: var(--pri); background: var(--pri-2); }
.msheet .sp .num { background: var(--pin); color: #fff; }
.msheet .sp.on .num { background: var(--pin-2); }
.msteps { list-style: none; margin: 0; padding: 0 16px 8px; overflow-y: auto; }
.msteps li { display: block; }
.ms-a { display: flex; align-items: center; gap: 12px; padding: 8px 0; }
.ms-a > .ic { width: 26px; height: 26px; padding: 4px; border-radius: 9px; background: var(--ok-2); color: var(--ok); }
.ms-a > span, .ms-s > span:last-child { display: flex; flex-direction: column; min-width: 0; }
.ms-a small, .ms-s small { color: var(--ink-3); font-family: var(--num); }
.ms-l { display: flex; align-items: center; gap: 10px; margin: 0 0 0 10px; padding: 6px 0 6px 18px; border-left: 3px solid var(--m); font-size: 13px; color: var(--ink-2); }
.ms-s { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; padding: 8px 8px 8px 0; border-radius: 12px; }
.ms-s .num { background: var(--pin); color: #fff; }
.ms-s.on { background: var(--pri-2); }
.poi-card { position: absolute; left: 12px; right: 12px; z-index: 7; background: var(--surface); border-radius: 20px; padding: 12px; box-shadow: 0 4px 22px rgba(15, 36, 56, .22); display: grid; grid-template-columns: auto 1fr auto; gap: 4px 12px; align-items: center; }
.mapfull.has-sheet .poi-card { bottom: 128px; }
.mapfull.no-sheet .poi-card { bottom: 150px; }
.mapfull.is-full .poi-card { display: none; }
.poi-card .ct { width: 42px; height: 42px; border-radius: 14px; }
.pc-t { display: flex; flex-direction: column; min-width: 0; }
.pc-t b { font-size: 15.5px; }
.pc-t small { color: var(--ink-3); font-size: 12.5px; }
.pc-d { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink-2) !important; }
.pc-b { grid-column: 1 / -1; }
.mapfull.no-sheet .map-ctl2 { top: 138px; }
/* 지도 안 도형 */
.dmap .sea { fill: var(--sea); }
.dmap .land { fill: var(--land); stroke: var(--sea-edge); }
.dist-t { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-anchor: middle; fill: color-mix(in srgb, var(--ink-2) 80%, transparent); paint-order: stroke; stroke: var(--land); stroke-width: 3.5px; stroke-linejoin: round; pointer-events: none; }
.seg-halo { stroke: #fff; stroke-width: 9; opacity: 1; }
:root[data-theme="dark"] .seg-halo { stroke: var(--surface); }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .seg-halo { stroke: var(--surface); } }
.gpin { cursor: pointer; outline: none; }
.gp-b { fill: var(--pin); stroke: #fff; stroke-width: 1.8; stroke-linejoin: round; }
.gp-n { fill: #fff; font-family: var(--num); font-size: 13px; font-weight: 700; text-anchor: middle; pointer-events: none; }
.gp-sh { fill: rgba(15, 36, 56, .28); }
.gpin.on .gp-b { fill: var(--pin-2); }
.gpin.walkp .gp-b { fill: var(--ok); }
.gpin:focus-visible .gp-b { stroke: var(--pri); stroke-width: 3; }
.gp-l { font-size: 12.5px; font-weight: 700; fill: var(--ink); paint-order: stroke; stroke: #fff; stroke-width: 3.5px; stroke-linejoin: round; pointer-events: none; }
.gp-l.on { font-size: 13.5px; font-weight: 800; }
:root[data-theme="dark"] .gp-l { stroke: var(--land); }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .gp-l { stroke: var(--land); } }
.poi { cursor: pointer; outline: none; }
.poi circle { fill: var(--c); stroke: #fff; stroke-width: 2; }
.poi.other circle { fill: color-mix(in srgb, var(--c) 45%, #fff); }
.poi-ic { fill: none; stroke: #fff; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
.poi-l { font-size: 11.5px; font-weight: 700; text-anchor: middle; fill: var(--ink); paint-order: stroke; stroke: #fff; stroke-width: 3px; stroke-linejoin: round; pointer-events: none; }
