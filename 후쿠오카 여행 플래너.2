  return `<div class="sh-h"><div><h2>이동 방법</h2><p>${esc(aN)} → ${esc(bN)} · ${dist(km(A, B))}</p></div><button class="ib sm" data-act="closeSheet" aria-label="닫기">${ic('close')}</button></div>
