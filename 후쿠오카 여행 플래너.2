  const cur = li < c.rows.length ? c.rows[li].leg : c.endLeg, opts = cur.opts;
  const aN = ptName(p, S.di, li), bN = li < c.rows.length ? itemName(p, c.rows[li].it) : (c.day.end.kind === 'airport' ? '공항' : '숙소');
