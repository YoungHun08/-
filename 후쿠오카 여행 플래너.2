  const R = sh.recs, pts = [R.A, R.B, ...R.recs.map(r => r.s)];
  const { P, s } = linear(pts, W, H, 34, 0.8);
  let h = geoSVG(P, 1, { stations: s > 160, riverW: clamp(s * 0.05, 1.5, 6), lineW: 2 });
  const a = P(R.A.lat, R.A.lng), b = P(R.B.lat, R.B.lng);
  h += `<path class="corr" style="stroke-width:${f1(R.corridor * 2 * s)}" d="M${a.map(f1).join(',')}L${b.map(f1).join(',')}"/>`;
  h += `<path class="rseg" style="stroke:${MODE.walk.color};${SEG_STYLE.walk}" d="M${a.map(f1).join(',')}L${b.map(f1).join(',')}"/>`;
  R.recs.forEach((r, k) => { const [x, y] = P(r.s.lat, r.s.lng), on = sh.picks.includes(r.s.id); h += `<g class="rpin${on ? ' on' : ''}" data-act="recToggle" data-id="${r.s.id}" transform="translate(${f1(x)},${f1(y)})"><circle r="11"/><text y="4">${k + 1}</text></g>`; });
  [[a, '출발'], [b, '도착']].forEach(([p, t]) => { h += `<g class="ab-pin" transform="translate(${f1(p[0])},${f1(p[1])})"><rect x="-17" y="-11" width="34" height="22" rx="11"/><text y="4">${t}</text></g>`; });
  el.innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="걷는 길 추천 지도">${h}</svg>`;
}


applyTheme(S.theme);
render();
store.init();
</script>
</body>
</html>
