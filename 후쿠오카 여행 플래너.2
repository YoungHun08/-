      <div class="wl">${g.list.map(s => wishCard(s, X.wish.includes(s.id), 'toggleWish', { tag: X.asg && X.asg[s.id] != null ? `${X.asg[s.id] + 1}일차` : '' })).join('')}</div></section>`;
