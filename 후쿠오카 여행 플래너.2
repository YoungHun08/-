  if (di === 0 || di === N - 1) return `<button class="lnk fmemo-add" data-act="dayTime">${ic('plane')}${di === 0 && di !== N - 1 ? '후쿠오카 도착 시간 메모 추가' : di === N - 1 && di !== 0 ? '후쿠오카 떠나는 시간 메모 추가' : '도착·떠나는 시간 메모 추가'}</button>`;
  return '';
}
function syncSummary(p, before, after) {
  const L = [];
  if (before.start !== after.start) L.push({ k: 'ok', t: `<b>출발</b> ${fmt(before.start)} → ${fmt(after.start)}` });
  const legs = [...after.rows.map((r, i) => ({ leg: r.leg, b: itemName(p, r.it), arr: r.arr })), { leg: after.endLeg, b: after.day.end.kind === 'airport' ? '공항' : '숙소', arr: after.endArr }];
  legs.filter(x => x.leg.tt && x.leg.mode !== 'none' && !x.leg.lastGone && x.leg.mode !== 'walk').slice(0, 4).forEach(x => L.push({ k: '', t: `<b>다음 ${MODE[x.leg.mode].n}</b> ${fmt(x.leg.depAt % 1440)} 출발${x.leg.wait ? ` (${x.leg.wait}분 대기)` : ''} → ${esc(x.b)} ${fmt(x.arr)} 도착` }));
  legs.filter(x => x.leg.lastGone).forEach(x => L.push({ k: 'warn', t: `<b>막차가 끝났어요</b> ${MODE[x.leg.mode].n}은(는) 첫차까지 기다려야 해요. 택시로 바꿔 보세요.` }));
  const d = after.endArr - before.endArr;
  L.push({ k: after.over > 0 ? 'warn' : 'ok', t: `<b>마무리</b> ${fmt(before.endArr)} → ${fmt(after.endArr)}${d ? ` (${d > 0 ? '+' : ''}${d}분)` : ''}${after.over > 0 ? ` · 목표보다 ${after.over}분 늦어요` : ''}` });
  const was = new Set(before.rows.flatMap(r => r.warn.map(w => r.it.uid + w)));
  after.rows.forEach(r => r.warn.forEach(w => { if (!was.has(r.it.uid + w) && L.length < 9) L.push({ k: 'warn', t: `<b>${esc(itemName(p, r.it))}</b> ${esc(w)}` }); }));
  return L;
}
function bannerV() {
  const b = S.banner; if (!b) return '';
