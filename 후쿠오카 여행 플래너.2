// ---- 시트: 오늘 갈 곳 고르기 ----
function pickSheet(sh) {
  const p = S.plan, asg = assignedMap(p), q = (sh.q || '').trim().toLowerCase();
  const list = p.wish.filter(id => p.visited[id] == null).map(id => SPOT[id]).filter(s => s && (sh.cat === 'all' || s.c === sh.cat) && (!q || (s.n + s.j + AREA[s.a].n + CATS[s.c].n).toLowerCase().includes(q)));
  const groups = AREAS.map(a => ({ a, list: list.filter(s => s.a === a.id) })).filter(g => g.list.length);
  const sim = sh.picks.length ? simulateDay(p, S.di, sh.picks) : null, cur = p.days[S.di].items.filter(i => !i.fixed).length;
  const cats = [['all', '전체'], ...Object.entries(CATS).map(([k, v]) => [k, v.n])];
  const body = groups.length ? groups.map(g => `<section class="wgrp"><div class="wg-h"><div><h3>${g.a.n}</h3><small>${g.list.filter(s => sh.picks.includes(s.id)).length}/${g.list.length}곳 선택</small></div></div>
      <div class="wl">${g.list.map(s => {
        const on = sh.picks.includes(s.id), d = asg[s.id];
        return wishCard(s, on, 'pickToggle', { tag: d != null && d !== S.di ? `${d + 1}일차에서 옮김` : '' });
      }).join('')}</div></section>`).join('')
    : `<p class="note">${ic('heart')}<span>${p.wish.length ? '조건에 맞는 곳이 없어요.' : '체크해 둔 곳이 없어요. 위시 탭에서 먼저 체크하거나 아래에서 찾아 넣어 보세요.'}</span></p>`;
  let sum;
  if (!sim) sum = `<p class="pk-hint">${ic('route')}<span>${cur ? '모두 빼면 이 날이 비어요.' : '갈 곳을 고르면 최적 루트와 교통비를 바로 보여 드려요.'}</span></p>`;
  else sum = `<div class="pk-sum">
      <div class="pk-ord">${sim.order.map((id, k) => `<span class="oc"><i>${k + 1}</i>${esc(SPOT[id].n)}</span>`).join('<span class="ar">›</span>')}</div>
      <div class="pk-st"><div><small>이동</small><b>${dur(sim.travel)}</b></div><div><small>걷기</small><b>${sim.walkKm.toFixed(1)}km</b></div><div><small>교통비</small><b>${sim.approx ? '약 ' : ''}${yen(sim.fare)}</b></div><div><small>마무리</small><b class="${sim.over > 0 ? 'bad-t' : ''}">${fmt(sim.endArr)}</b></div></div>
      ${sim.over > 0 ? `<p class="pk-w">${ic('alert')}목표(${fmt(sim.deadline)})보다 ${sim.over}분 늦어요. 한 곳 줄여 보세요.</p>` : `<p class="pk-ok">${ic('check')}${fmt(sim.deadline)}까지 ${dur(Math.max(0, sim.deadline - sim.endArr))} 여유</p>`}
    </div>`;
  return `<div class="sh-h"><div><h2>${S.di + 1}일차에 갈 곳 고르기</h2><p>${md(p.days[S.di].date)} · 체크해 둔 ${p.wish.length}곳 중에서 골라요</p></div><button class="ib sm" data-act="closeSheet" aria-label="닫기">${ic('close')}</button></div>
    <label class="search">${ic('search')}<span class="sr">검색</span><input id="pickQ" data-input="pickQ" value="${esc(sh.q)}" placeholder="이름·동네·종류"></label>
    <div class="chips-sel scroll">${cats.map(([k, v]) => `<button class="${sh.cat === k ? 'on' : ''}" data-act="pickCat" data-v="${k}">${v}</button>`).join('')}</div>
    <div class="pk-list">${body}
      <button class="lnk center" data-act="addOpen">${ic('plus')}위시에 없는 곳도 찾아서 넣기</button></div>
    <div class="pk-foot">${sum}
      <div class="sh-foot"><button class="btn soft" data-act="closeSheet">취소</button><button class="btn pri" data-act="pickApply" ${!sh.picks.length && !cur ? 'disabled' : ''}>${ic('route')}${sh.picks.length ? `${sh.picks.length}곳 최적 루트로 짜기` : '이 날 비우기'}</button></div></div>`;
}
function dayTimeSheet() {
  const p = S.plan, day = p.days[S.di], N = p.days.length, lastAir = day.end.kind === 'airport', firstAir = day.start.kind === 'airport';
  const fi = p.set.flightIn || { no: '', time: '' }, fo = p.set.flightOut || { no: '', time: '' };
  const fld = (id, val, label, hint, now) => `<div class="tfld"><label for="${id}">${label}</label><div class="trow"><input type="time" id="${id}" value="${val}" step="60">${now ? `<button class="btn live sm" data-act="fillNow" data-t="${id}">${ic('clock')}지금</button>` : ''}</div>${hint ? `<small>${hint}</small>` : ''}</div>`;
  const fl = (tId, v, label, tl) => `<div class="tfld fl"><label for="${tId}">${ic('plane')}${label} <small>참고용 메모</small></label><div class="trow"><input type="text" inputmode="numeric" id="${tId}" data-blur="timeFmt" value="${esc(v.time || '')}" placeholder="예: 10:25" maxlength="5" autocomplete="off"></div><small>${tl} · 숫자만 쳐도 돼요. 일정 시간에는 영향이 없어요.</small></div>`;
