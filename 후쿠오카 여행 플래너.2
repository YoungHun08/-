  if (/1시간 간격|고속버스|유후인호/.test(L)) return 60;
  if (/신칸센/.test(L)) return 15;
  if (/니시테츠/.test(L) && mode === 'train') return 15;
  if (/페리|도선|우미나카 라인|선착장/.test(L) || mode === 'ferry') return 45;
